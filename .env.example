# Copy this file to .env.local and fill in your staging (or prod) Supabase
# project's values from Project Settings -> API in the Supabase dashboard.
# .env.local is gitignored (matches *.local) — never commit real values.

VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-STAGING-ANON-KEY
