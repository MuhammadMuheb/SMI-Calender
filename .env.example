# Copy this file to .env.local and fill in your Firebase and other configuration values.
# .env.local is gitignored (matches *.local) — never commit real values.

# Firebase Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Web Push Notifications (from Firebase Console > Cloud Messaging)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
