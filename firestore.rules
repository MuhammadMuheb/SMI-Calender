rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isManager() {
      return isAuthenticated() && request.auth.token.role in ['manager', 'super_admin'];
    }

    function isStaff() {
      return isAuthenticated() && request.auth.token.role in ['staff', 'manager', 'super_admin'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===== Users Collection =====
    match /users/{userId} {
      // Allow authenticated users to read (app controls access via UI)
      allow read: if isAuthenticated();
      // Allow authenticated users to update/delete (app controls access via UI + audit trail)
      allow update, delete: if isAuthenticated();
      // Allow creating users: normally via Cloud Function, but also direct creation for testing/admin setup
      // SECURITY: In production, restrict this further and use Cloud Function only
      allow create: if isAuthenticated();
    }

    // ===== Leave Requests =====
    match /leave_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ===== Notifications =====
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ===== Swaps =====
    match /swaps/{swapId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ===== Tasks =====
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ===== Staff Management (Users read with role) =====
    match /staffing_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /role_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /special_days/{dayId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ===== Vacation Adjustments =====
    match /vacation_adjustments/{adjustmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ===== Audit Log =====
    match /audit_log/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ===== Check-ins =====
    match /check_ins/{checkInId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // ===== Push Subscriptions =====
    match /push_subscriptions/{subscriptionId} {
      allow read, write: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // ===== Deny everything else =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
